{
  "name": "@psyduck25/dsh-session-manager",
  "version": "0.8.0",
  "type": "module",
  "description": "Delete a single session with a two-step confirmation and a recycle bin: browse every session by workspace, lock the ones to keep, and recover deleted sessions until the configurable buffer window expires.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "recycle-bin",
    "settings"
  ],
  "license": "MIT",
  "author": "psyduck25",
  "homepage": "https://github.com/psyduck25/dsh-session-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psyduck25/dsh-session-manager.git"
  },
  "bugs": {
    "url": "https://github.com/psyduck25/dsh-session-manager/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "assets",
    "screenshots.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.3"
  }
}
