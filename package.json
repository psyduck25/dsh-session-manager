{
  "name": "dsh-session-manager",
  "version": "0.4.0",
  "type": "module",
  "description": "Delete a single session with a two-step confirmation and a recycle bin: browse every session by workspace, lock the ones to keep, and recover deleted sessions until the configurable buffer window expires.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "recycle-bin",
    "settings"
  ],
  "license": "MIT",
  "author": "dsh-session-manager contributors",
  "homepage": "https://github.com/OWNER/dsh-session-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-session-manager.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/dsh-session-manager/issues"
  },
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.3"
  }
}
